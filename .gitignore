/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# private Uploads (Vereinsnachweise) - duerfen nie ins Repo
/data/

# vercel
.vercel

# playwright-cli debug logs
.playwright-cli/

# typescript
*.tsbuildinfo
next-env.d.ts

# Uploads entstehen ausschließlich im Betrieb.
/public/uploads/

.runtime/
/transfer/
/backup/

/THIRD_PARTY_LICENSES.txt
