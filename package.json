{
  "name": "pfotenweb",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:runtime",
    "start": "NODE_ENV=production node --env-file-if-exists=.env .runtime/env.selftest.js && next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "check": "tsx src/lib/password.selftest.ts",
    "check:env": "tsx --env-file-if-exists=.env src/lib/env.selftest.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build:runtime": "tsc src/lib/env.ts src/lib/env.selftest.ts --outDir .runtime --module commonjs --target es2022 --esModuleInterop --skipLibCheck",
    "setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "data:import": "tsx --env-file-if-exists=.env scripts/import.ts",
    "check:import": "tsx scripts/import.selftest.ts",
    "check:uploads": "tsx scripts/upload-image.selftest.ts",
    "check:media": "tsx scripts/media-cleanup.selftest.ts",
    "check:access": "tsx scripts/access.selftest.ts",
    "check:mail": "tsx scripts/mail.selftest.ts",
    "check:inquiries": "tsx scripts/inquiries.selftest.ts",
    "check:auth": "tsx scripts/auth.selftest.ts",
    "check:profiles": "tsx scripts/profiles.selftest.ts",
    "check:upgrade": "tsx scripts/upgrade.selftest.ts",
    "check:documents": "tsx scripts/animal-documents.selftest.ts",
    "check:content-import": "tsx scripts/content-import.selftest.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.5",
    "csv-parse": "7.0.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.43.0",
    "next": "16.3.8",
    "nodemailer": "10.0.10",
    "postgres": "^3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.21.0",
  "description": "Eine selbst gehostete Website f\u00fcr einen Tierschutzverein",
  "repository": {
    "type": "git",
    "url": "https://github.com/Livvux/pfotenweb.git"
  }
}
