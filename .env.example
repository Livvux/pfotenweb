# Passwort z.B. mit openssl rand -hex 32 erzeugen. Keine Sonderzeichen in der DB-URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://pfotenweb:PASSWORT@127.0.0.1:5432/pfotenweb
SITE_URL=https://tierheim.example.org
DOMAIN=tierheim.example.org
ACME_EMAIL=
INITIAL_ORG_NAME=Mein Tierschutzverein
INITIAL_ADMIN_USERNAME=vorstand
# Mindestens 16 Zeichen; keine voreingestellten Zugangsdaten.
INITIAL_ADMIN_PASSWORD=
# Optionaler Versand von Benachrichtigungen; Anfragen bleiben immer im Vereinszugang.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
